{
  "name": "email-scheduler-backend",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker:dev": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "worker": "node dist/src/worker.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run tests/idempotency.test.ts tests/rateLimiter.test.ts tests/scheduling.test.ts"
    ,"seed:senders": "tsx src/seedSenders.ts"
  },
  "dependencies": {
    "google-auth-library": "latest",
    "@prisma/client": "6.19.0",
    "bullmq": "latest",
    "cookie-parser": "latest",
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "ioredis": "latest",
    "nodemailer": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/cookie-parser": "latest",
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/nodemailer": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest",
    "prisma": "6.19.0"
  }
}
